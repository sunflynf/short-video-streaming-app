NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_SECONDS=900

# Mux (https://dashboard.mux.com → Settings → Access Tokens / Webhooks).
# Leave empty to run without uploads; /videos/upload and /webhooks/mux return 503.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MAX_VIDEO_DURATION_SEC=60
MAX_ACTIVE_UPLOADS=3
MAX_DAILY_UPLOADS=20
# Optional: comma-separated Mux public playback ids for `pnpm prisma:seed` to create READY videos.
SEED_MUX_PLAYBACK_IDS=
