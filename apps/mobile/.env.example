# Use your machine's LAN IP (not localhost) when running on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:3000/v1
# Base URL of shared links (the API's PUBLIC_WEB_URL); /v/:id links open the in-app video screen.
EXPO_PUBLIC_WEB_URL=http://localhost:3000
# Optional: crash reporting. Source maps upload during EAS builds when SENTRY_AUTH_TOKEN,
# SENTRY_ORG and SENTRY_PROJECT are set as EAS secrets.
EXPO_PUBLIC_SENTRY_DSN=
# Optional: product analytics (PostHog project API key). Without it, analytics calls do nothing.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
